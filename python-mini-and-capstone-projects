# Option 1: Employee Data Analysis Project
def employee_analysis():
    print("\n--- Employee Data Analysis ---")
    data = {
        'EmployeeID': [101, 102, 103, 104, 105],
        'Name': ['Alice', 'Bob', 'Charlie', 'David', 'Eva'],
        'Department': ['IT', 'HR', 'IT', 'Finance', 'HR'],
        'Salary': [75000, 48000, 90000, 60000, 52000]
    }
    df = pd.DataFrame(data)
    print("\nOriginal Dataset:\n", df)
    
    avg_salary = df['Salary'].mean()
    print(f"\nAverage Salary: {avg_salary}")
    print("\nDepartment Counts:\n", df['Department'].value_counts())
    
    filtered_df = df[df['Salary'] > 55000]
    print("\nEmployees with Salary > 55000:\n", filtered_df)
    
    filtered_df.to_csv('filtered_employees.csv', index=False)
    print("\nExported filtered data to 'filtered_employees.csv'")

# Option 2: COVID-19 Data Tracker
def covid_tracker():
    print("\n--- COVID-19 Data Tracker ---")
    data = {
        'Country': ['USA', 'India', 'Brazil', 'France', 'Germany'],
        'Total_Cases': [103000000, 45000000, 37000000, 40000000, 38000000]
    }
    df = pd.DataFrame(data)
    top5 = df.sort_values(by='Total_Cases', ascending=False).head(5)
    print("Top 5 Countries:\n", top5)
    
    plt.figure(figsize=(7, 4))
    plt.bar(top5['Country'], top5['Total_Cases'], color='skyblue')
    plt.xlabel('Country')
    plt.ylabel('Total Cases')
    plt.title('Top 5 Countries by COVID-19 Cases')
    plt.show()

# Option 3: Email Automation Tool (Bulk)
def bulk_email_automation():
    print("\n--- Bulk Email Automation Tool ---")
    sender_email = input("Enter sender email: ")
    sender_password = input("Enter app password: ")
    
    students = [
        {"Name": "Student 1", "Email": "student1@example.com"},
        {"Name": "Student 2", "Email": "student2@example.com"}
    ]
    
    try:
        server = smtplib.SMTP("smtp.gmail.com", 587)
        server.starttls()
        server.login(sender_email, sender_password)
        
        for student in students:
            msg = MIMEMultipart()
            msg["From"] = sender_email
            msg["To"] = student["Email"]
            msg["Subject"] = f"Hello {student['Name']}"
            msg.attach(MIMEText(f"Hi {student['Name']},\nThis is an automated update.", "plain"))
            
            server.sendmail(sender_email, student["Email"], msg.as_string())
            print(f"Sent email to {student['Name']}")
            
        server.quit()
    except Exception as e:
        print(f"Error: {e}")


